rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if current authenticated user is admin
    function isAdmin() {
      return request.auth != null && ('email' in request.auth.token) && request.auth.token.email.lower() == 'ddespasiano@gmail.com';
    }

    // Quizzes collection
    match /quizzes/{quizId} {
      // Anyone can read quizzes
      allow read: if true;
      
      // Write allowed
      allow write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Quiz attempts collection for student history and ranking
    match /quiz_attempts/{attemptId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
